{
  "name": "@q1k-oss/behaviour-tree-workflows",
  "version": "0.0.2",
  "description": "Behavior tree library for TypeScript — 30+ production-ready nodes, YAML workflows, Temporal integration, and built-in observability",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "behavior-tree",
    "behaviour-tree",
    "workflow",
    "yaml",
    "temporal",
    "ai",
    "orchestration"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/q1k-oss/behaviour-tree-workflows"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "tsup-node src/index.ts --watch --format cjs,esm --dts",
    "build": "npm run clean && tsup-node src/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "test": "CI=true vitest --coverage",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@activepieces/piece-google-sheets": "^0.14.0",
    "@activepieces/pieces-framework": "^0.23.0",
    "@temporalio/activity": "^1.10.0",
    "@temporalio/workflow": "^1.10.0",
    "js-yaml": "^4.1.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@temporalio/client": "^1.10.0",
    "@temporalio/testing": "^1.10.0",
    "@temporalio/worker": "^1.10.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "latest",
    "vitest": "^3.2.4"
  }
}
